                <mxCell id="XwY2HbKuNy5zRUsskIL4-30" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 10px;&quot;&gt;A dataset is a logical container of multiple documents. It has a reference uri that is basically the pointer to its document container (like a folder, a bucket s3...). When a user creates a dataset define its source uri and select which documents to ingest.&lt;/span&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;fontColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="990" y="-460" width="210" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="XwY2HbKuNy5zRUsskIL4-31" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 10px;&quot;&gt;A document is a reference file inside a selected source dataset. The same document may be in multiple logical dataset while beeing in the same dataset location uri.&lt;/span&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;fontColor=#F0F0F0;" parent="1" vertex="1">
