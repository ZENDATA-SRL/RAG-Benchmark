# Copy to `.env` and adjust. Never commit real secrets.
# Both `docker-compose.yml` and the application read this file, so the credentials
# below are the single source of truth for the local environment.

# --- Application -------------------------------------------------------------
APP_NAME=RAG Benchmark API
APP_VERSION=0.1.0

# --- PostgreSQL --------------------------------------------------------------
# Consumed by docker-compose to provision the container.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=rag-bench
POSTGRES_PORT=5432

# Consumed by the application and by Alembic. Must match the three values above.
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/rag-bench
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Database used by the test suite; created on demand by the fixtures.
TEST_DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/rag-bench-test

# --- Object storage (MinIO in local, any S3-compatible service elsewhere) ----
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=rag-bench
STORAGE_REGION=us-east-1
# Set to true when the endpoint is HTTPS with a valid certificate.
STORAGE_SECURE=false

# --- Temporal ----------------------------------------------------------------
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=rag-bench

# --- Vector store (Chroma) ---------------------------------------------------
# Host view of the `chromadb` compose service; the worker container uses its own values.
CHROMA_HOST=localhost
CHROMA_PORT=8001

# --- Vector store (Qdrant) ---------------------------------------------------
# Host view of the `qdrant` compose service; the worker container uses its own values.
QDRANT_HOST=localhost
QDRANT_PORT=6333

# --- Embedder credentials (worker and API) -----------------------------------
# The OpenAI embedder reads OPENAI_API_KEY from the *process* environment, and this file is
# not exported to it: export the key in the shell that runs the worker and the API (the API
# needs it too, since it embeds retrieval queries with the same model as the index).
#   export OPENAI_API_KEY=...

# --- AWS (Bedrock embedder, worker container) --------------------------------
# The worker mounts this directory read-only and uses the named profile: credentials stay
# in ~/.aws and are never copied into compose or this file.
# AWS_CONFIG_DIR=~/.aws
# WORKER_AWS_PROFILE=default

# --- Upload limits -----------------------------------------------------------
# 200 MB; the upload path streams to storage, so this bounds storage and not memory.
MAX_UPLOAD_BYTES=209715200
# JSON list. Only PDF in the MVP.
ALLOWED_MIME_TYPES=["application/pdf"]

# --- HTTP --------------------------------------------------------------------
# JSON list of origins allowed by CORS; the Vite dev server in local.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
LOG_LEVEL=INFO
